{
  "version": 2,
  "builds": [
    {
      "src": "builds.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    },
    {
      "src": "DebugAI/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "theme/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "DebugAI/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "DebugAI/wsgi.py"
    }
  ]
}